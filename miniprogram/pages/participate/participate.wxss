/* pages/participate/participate.wxss */
page {
  background-color: #f5f7fa;
}

.container {
  padding-bottom: 120rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #0052D9 0%, #003ba3 100%);
  padding: 40rpx 30rpx 30rpx;
  color: white;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.header .title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.header .subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 内容区域 */
.content {
  padding: 0 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 82, 217, 0.1);
  width: 100%;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 25rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #e5e7eb;
}

/* 商品列表 */
.goods-item {
  border: 2rpx solid #e5e7eb;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  background: #f9fafb;
  width: 100%;
  box-sizing: border-box;
}

.goods-info {
  margin-bottom: 20rpx;
}

.goods-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.goods-price {
  font-size: 28rpx;
  color: #0052D9;
  font-weight: bold;
}

/* 数量控制 - TDesign风格 */
.quantity-control {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
  gap: 15rpx;
}

.quantity-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: white;
  border: none;
  padding: 0;
  transition: all 0.2s ease;
}

.quantity-btn::after {
  border: none;
}

.quantity-btn.decrease {
  background: #e34d59;
  box-shadow: 0 2rpx 8rpx rgba(227, 77, 89, 0.3);
}

.quantity-btn.decrease:active {
  background: #d73d49;
  transform: scale(0.95);
}

.quantity-btn.increase {
  background: #00a870;
  box-shadow: 0 2rpx 8rpx rgba(0, 168, 112, 0.3);
}

.quantity-btn.increase:active {
  background: #009865;
  transform: scale(0.95);
}

.quantity-input {
  width: 100rpx;
  height: 48rpx;
  text-align: center;
  border: 2rpx solid #dcdcdc;
  border-radius: 8rpx;
  font-size: 28rpx;
  background: white;
  box-sizing: border-box;
  line-height: 44rpx;
}

.quantity-input:focus {
  border-color: #0052D9;
  outline: none;
}

.item-total {
  text-align: center;
  font-size: 26rpx;
  color: #0052D9;
  font-weight: bold;
}

/* 表单项 */
.form-item {
  margin-bottom: 30rpx;
  width: 100%;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #1f2937;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.input, .textarea {
  width: 100%;
  padding: 25rpx 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 10rpx;
  font-size: 28rpx;
  background: #f9fafb;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.4;
}

.input:focus, .textarea:focus {
  border-color: #0052D9;
  background: white;
  outline: none;
}

.textarea {
  height: 140rpx;
  resize: none;
  padding-top: 20rpx;
}

/* 订单汇总 */
.order-summary {
  background: #eff6ff;
  border-radius: 15rpx;
  padding: 25rpx;
  width: 100%;
  box-sizing: border-box;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.summary-item:last-of-type {
  border-bottom: none;
  margin-bottom: 20rpx;
}

.item-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
  flex: 1;
}

.item-detail {
  font-size: 24rpx;
  color: #6b7280;
  margin: 0 20rpx;
}

.item-amount {
  font-size: 28rpx;
  color: #0052D9;
  font-weight: bold;
}

.total-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 15rpx;
  border-top: 2rpx solid #0052D9;
}

.total-label {
  font-size: 32rpx;
  color: #1f2937;
  font-weight: bold;
}

.total-amount {
  font-size: 36rpx;
  color: #0052D9;
  font-weight: bold;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #f5f7fa;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #e5e7eb;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #0052D9 0%, #003ba3 100%);
  color: white;
  border-radius: 50rpx;
  padding: 25rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  border: none;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 82, 217, 0.3);
  transition: all 0.2s ease;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active:not(.disabled) {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 82, 217, 0.4);
}

.submit-btn.disabled {
  background: #d1d5db;
  opacity: 0.6;
  box-shadow: none;
}