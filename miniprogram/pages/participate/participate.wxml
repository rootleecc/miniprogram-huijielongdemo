<!--pages/participate/participate.wxml-->
<view class="container">
  <view class="header">
    <text class="title">参与接龙</text>
    <text class="subtitle">{{dragon.title}}</text>
  </view>

  <view class="content">
    <!-- 商品选择 -->
    <view class="section">
      <view class="section-title">选择商品</view>
      <view class="goods-list">
        <view class="goods-item" wx:for="{{selectedItems}}" wx:key="goodsIndex">
          <view class="goods-header">
            <view class="goods-info">
              <view class="goods-name">{{item.goodsName}}</view>
              <view class="goods-price">¥{{item.price}}/{{item.unit}}</view>
            </view>
            
            <view class="quantity-control">
              <button class="quantity-btn decrease" bindtap="changeQuantity" data-index="{{index}}" data-type="decrease">-</button>
              <input class="quantity-input" type="number" value="{{item.quantity}}" bindinput="onQuantityInput" data-index="{{index}}"/>
              <button class="quantity-btn increase" bindtap="changeQuantity" data-index="{{index}}" data-type="increase">+</button>
            </view>
          </view>
          
          <view class="item-total" wx:if="{{item.quantity > 0}}">
            <text>小计：¥{{item.subtotal}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 联系信息 -->
    <view class="section">
      <view class="section-title">联系信息</view>
      <view class="form-item">
        <text class="label">联系方式 *</text>
        <input class="input" placeholder="请输入微信号、手机号等" value="{{contactInfo}}" bindinput="onContactInput" maxlength="50"/>
      </view>
      <view class="form-item">
        <text class="label">备注</text>
        <textarea class="textarea" placeholder="特殊要求、配送地址等" value="{{remark}}" bindinput="onRemarkInput" maxlength="200"></textarea>
      </view>
    </view>

    <!-- 订单汇总 -->
    <view class="section">
      <view class="section-title">订单汇总</view>
      <view class="order-summary">
        <view class="summary-item" wx:for="{{selectedItems}}" wx:key="goodsIndex" wx:if="{{item.quantity > 0}}">
          <text class="item-name">{{item.goodsName}}</text>
          <text class="item-detail">{{item.quantity}}{{item.unit}} × ¥{{item.price}}</text>
          <text class="item-amount">¥{{item.subtotal}}</text>
        </view>
        
        <view class="total-line">
          <text class="total-label">总计：</text>
          <text class="total-amount">¥{{totalAmount}}</text>
        </view>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submitParticipation" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '确认参与'}}
      </button>
    </view>
  </view>
</view>