/* pages/profile/profile.wxss */
page {
  background-color: #f5f7fa;
}

.container {
  min-height: 100vh;
  padding-bottom: 100rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 登录区域 */
.login-section {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.login-card {
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(0, 82, 217, 0.1);
  width: 100%;
  max-width: none;
  box-sizing: border-box;
}

.login-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.login-desc {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 60rpx;
  line-height: 1.6;
}

/* 主要登录按钮 */
.login-btn {
  background: linear-gradient(135deg, #0052D9 0%, #003ba3 100%);
  color: white;
  border-radius: 50rpx;
  padding: 35rpx 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.3);
  width: 100%;
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.login-btn-text {
  color: white;
}

/* 备用登录按钮 */
.manual-login-btn {
  background: transparent;
  color: #6b7280;
  border: 2rpx solid #e5e7eb;
  border-radius: 50rpx;
  padding: 25rpx 40rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.manual-login-text {
  color: #6b7280;
}

/* 设置区域 */
.manual-setup {
  margin-top: 30rpx;
}

.setup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
  margin-bottom: 40rpx;
}

/* 头像选择 */
.avatar-wrapper {
  position: relative;
  margin-bottom: 30rpx;
  background: none;
  border: none;
  padding: 0;
}

.avatar-wrapper::after {
  border: none;
}

.login-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #f3f4f6;
}

.avatar-tip {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 15rpx;
}

/* 昵称输入 */
.nickname-wrapper {
  margin-bottom: 40rpx;
}

.nickname-input {
  width: 100%;
  padding: 35rpx 30rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 50rpx;
  font-size: 32rpx;
  text-align: center;
  background: #f9fafb;
  box-sizing: border-box;
  min-height: 100rpx;
  line-height: 1.4;
}

.nickname-input:focus {
  border-color: #0052D9;
  background: white;
}

/* 完成按钮 */
.complete-btn {
  background: linear-gradient(135deg, #0052D9 0%, #003ba3 100%);
  color: white;
  border-radius: 50rpx;
  padding: 35rpx 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.3);
  width: 100%;
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.complete-btn-text {
  color: white;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #0052D9 0%, #003ba3 100%);
  margin: 20rpx;
  border-radius: 24rpx;
  padding: 40rpx;
  color: white;
  box-shadow: 0 8rpx 40rpx rgba(0, 82, 217, 0.2);
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  margin-right: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 26rpx;
  opacity: 0.8;
}

/* 数据统计 */
.stats-section {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-number {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #0052D9;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 26rpx;
  color: #6b7280;
}

.stats-divider {
  width: 2rpx;
  height: 60rpx;
  background: #e5e7eb;
}

/* 内容区域 */
.profile-content {
  padding-bottom: 40rpx;
  width: 100%;
}

.section {
  margin: 20rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 35rpx 30rpx;
  border-bottom: 2rpx solid #f3f4f6;
  cursor: pointer;
  transition: background-color 0.2s;
}

.section-header:active {
  background-color: #f9fafb;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}

.section-toggle {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.section-count {
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 500;
}

.section-arrow {
  font-size: 28rpx;
  color: #9ca3af;
  transition: transform 0.3s ease;
  transform: rotate(0deg);
  font-weight: bold;
}

.section-arrow.expanded {
  transform: rotate(90deg);
}

/* 内容区域 */
.section-content {
  border-top: 2rpx solid #f3f4f6;
}

/* 加载和空状态 */
.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #9ca3af;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 60rpx 30rpx;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.4;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: #0052D9;
  color: white;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

/* 接龙列表 */
.dragon-list {
  padding: 25rpx 25rpx 30rpx;
}

.dragon-item {
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 35rpx 30rpx;
  margin-bottom: 20rpx;
  transition: background-color 0.2s;
  box-shadow: 0 2rpx 8rpx rgba(0, 82, 217, 0.05);
}

.dragon-item:last-child {
  margin-bottom: 0;
}

.dragon-item:active {
  background-color: #f1f5f9;
  border-color: #cbd5e1;
  transform: scale(0.98);
}

.dragon-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.dragon-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2937;
  flex: 1;
  margin-right: 20rpx;
  line-height: 1.4;
}

.dragon-status {
  padding: 10rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
  font-weight: 500;
}

.dragon-status.active {
  background: #10b981;
}

.dragon-status.ended {
  background: #9ca3af;
}

.dragon-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dragon-participants,
.dragon-creator {
  font-size: 26rpx;
  color: #6b7280;
}

.dragon-time {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 接龙操作按钮 */
.dragon-actions {
  display: flex;
  justify-content: center;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #e5e7eb;
}

.delete-btn {
  background: #ef4444;
  color: white;
  border-radius: 30rpx;
  padding: 10rpx 25rpx;
  font-size: 24rpx;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.3);
}

.delete-btn::after {
  border: none;
}

.delete-btn:active {
  transform: scale(0.95);
}

/* 功能菜单 */
.menu-section {
  margin: 20rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 45rpx 35rpx;
  border-bottom: 2rpx solid #f3f4f6;
  transition: background-color 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f9fafb;
}

.menu-item-content {
  flex: 1;
}

.menu-text {
  font-size: 32rpx;
  color: #1f2937;
  display: block;
  margin-bottom: 6rpx;
  font-weight: 500;
}

.menu-desc {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.4;
}

.menu-arrow {
  font-size: 30rpx;
  color: #9ca3af;
  font-weight: bold;
}