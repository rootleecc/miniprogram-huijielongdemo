<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 未登录状态 -->
  <view class="login-section" wx:if="{{!hasUserInfo}}">
    <view class="login-card">
      <text class="login-title">欢迎使用接龙购物</text>
      <text class="login-desc">登录后可查看我的接龙和参与记录</text>
      
      <!-- 登录按钮 -->
      <button class="login-btn" bindtap="startLogin" wx:if="{{!showManualSetup}}">
        <text class="login-btn-text">开始登录</text>
      </button>
      
      <!-- 设置区域（自动显示） -->
      <view class="manual-setup" wx:if="{{showManualSetup}}">
        <view class="setup-title">完善您的个人信息</view>
        <view class="setup-desc">无法自动获取信息，请手动设置</view>
        
        <!-- 头像选择 -->
        <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image class="login-avatar" src="{{userInfo.avatarUrl || '../../images/icons/avatar.png'}}" mode="aspectFill"></image>
          <view class="avatar-tip">点击选择头像</view>
        </button>
        
        <!-- 昵称输入 -->
        <view class="nickname-wrapper">
          <input 
            class="nickname-input" 
            type="nickname" 
            placeholder="请输入昵称" 
            value="{{userInfo.nickName}}"
            bind:blur="onNicknameBlur"
            bind:input="onNicknameInput"
            maxlength="20"
          />
        </view>
        
        <button class="complete-btn" bindtap="completeProfile">
          <text class="complete-btn-text">完成设置</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 已登录状态 -->
  <view class="profile-content" wx:else>
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <view class="user-info">
        <image class="user-avatar" src="{{userInfo.avatarUrl || '../../images/icons/avatar.png'}}" mode="aspectFill"></image>
        <view class="user-details">
          <text class="user-name">{{userInfo.nickName || '微信用户'}}</text>
          <text class="user-desc">接龙购物用户</text>
        </view>
      </view>
    </view>

    <!-- 数据统计 -->
    <view class="stats-section">
      <view class="stats-item">
        <text class="stats-number">{{myDragonsCount || 0}}</text>
        <text class="stats-label">发起的接龙</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-number">{{myParticipationsCount || 0}}</text>
        <text class="stats-label">参与的接龙</text>
      </view>
    </view>

    <!-- 我的接龙 -->
    <view class="section">
      <view class="section-header" bindtap="toggleMyDragons">
        <text class="section-title">我发起的接龙</text>
        <view class="section-toggle">
          <text class="section-count">{{myDragonsCount || 0}}个</text>
          <text class="section-arrow {{showMyDragons ? 'expanded' : ''}}">></text>
        </view>
      </view>
      
      <view class="section-content" wx:if="{{showMyDragons}}">
        <view class="loading" wx:if="{{loading}}">
          <text>加载中...</text>
        </view>
        
        <view class="empty-state" wx:elif="{{myDragons.length === 0}}">
          <image class="empty-icon" src="../../images/default-goods-image.png"></image>
          <text class="empty-text">还没有发起过接龙</text>
        </view>
        
        <view class="dragon-list" wx:else>
          <view class="dragon-item" wx:for="{{myDragons}}" wx:key="_id" bindtap="viewDragon" data-id="{{item._id}}">
            <view class="dragon-header">
              <text class="dragon-title">{{item.title}}</text>
              <view class="dragon-status {{item.status === 'active' ? 'active' : 'ended'}}">
                {{item.status === 'active' ? '进行中' : '已结束'}}
              </view>
            </view>
            <view class="dragon-info">
              <text class="dragon-participants">{{item.participantCount || 0}}人参与</text>
              <text class="dragon-time">{{item.createTime}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 我参与的接龙 -->
    <view class="section">
      <view class="section-header" bindtap="toggleMyParticipations">
        <text class="section-title">我参与的接龙</text>
        <view class="section-toggle">
          <text class="section-count">{{myParticipationsCount || 0}}个</text>
          <text class="section-arrow {{showMyParticipations ? 'expanded' : ''}}">></text>
        </view>
      </view>
      
      <view class="section-content" wx:if="{{showMyParticipations}}">
        <view class="loading" wx:if="{{loading}}">
          <text>加载中...</text>
        </view>
        
        <view class="empty-state" wx:elif="{{myParticipations.length === 0}}">
          <image class="empty-icon" src="../../images/default-goods-image.png"></image>
          <text class="empty-text">还没有参与过接龙</text>
        </view>
        
        <view class="dragon-list" wx:else>
          <view class="dragon-item" wx:for="{{myParticipations}}" wx:key="_id" bindtap="viewDragon" data-id="{{item._id}}">
            <view class="dragon-header">
              <text class="dragon-title">{{item.title}}</text>
              <view class="dragon-status {{item.status === 'active' ? 'active' : 'ended'}}">
                {{item.status === 'active' ? '进行中' : '已结束'}}
              </view>
            </view>
            <view class="dragon-info">
              <text class="dragon-creator">发起人：{{item.creatorName}}</text>
              <text class="dragon-time">{{item.updateTime}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-section">
      <view class="menu-item" bindtap="exportData">
        <view class="menu-item-content">
          <text class="menu-text">数据导出</text>
          <text class="menu-desc">导出我发起的接龙参与者信息</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="contactService">
        <view class="menu-item-content">
          <text class="menu-text">联系客服</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="aboutUs">
        <view class="menu-item-content">
          <text class="menu-text">关于我们</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>
</view>