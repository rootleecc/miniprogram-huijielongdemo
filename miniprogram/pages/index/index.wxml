<!--pages/index/index.wxml-->
<view class="container">
  <!-- 头部欢迎区域 -->
  <view class="header">
    <view class="welcome">
      <text class="title">接龙购物</text>
      <text class="subtitle">社群团购，优惠共享</text>
    </view>
  </view>

  <!-- 接龙列表 -->
  <view class="dragon-list">
    <view class="list-header">
      <text class="list-title">种草广场</text>
      <text class="list-count">{{dragonList.length}}个</text>
    </view>
    
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    
    <view class="empty" wx:elif="{{dragonList.length === 0}}">
      <image class="empty-icon" src="../../images/default-goods-image.png"></image>
      <text class="empty-text">暂无接龙活动</text>
      <navigator url="/pages/create/create" class="create-btn">发起第一个接龙</navigator>
    </view>
    
    <view class="dragon-item" wx:for="{{dragonList}}" wx:key="_id">
      <view class="dragon-header">
        <view class="dragon-title">{{item.title}}</view>
        <view class="dragon-status {{item.status === 'active' ? 'active' : 'ended'}}">
          {{item.status === 'active' ? '进行中' : '已结束'}}
        </view>
      </view>
      
      <view class="dragon-desc" bindtap="viewDragon" data-id="{{item._id}}">{{item.description}}</view>
      
      <!-- 商品图片展示 -->
      <view class="goods-preview" wx:if="{{item.goods && item.goods.length > 0}}" bindtap="viewDragon" data-id="{{item._id}}">
        <view class="goods-images">
          <image 
            class="goods-image" 
            wx:for="{{item.goods}}" 
            wx:key="index" 
            wx:for-item="goods"
            wx:if="{{goods.images && goods.images.length > 0 && index < 3}}"
            src="{{goods.images[0]}}" 
            mode="aspectFill"
          ></image>
          <view class="more-indicator" wx:if="{{item.goods.length > 3}}">
            <text class="more-text">+{{item.goods.length - 3}}</text>
          </view>
        </view>
        <view class="goods-names">
          <text class="goods-name-item" wx:for="{{item.goods}}" wx:key="index" wx:for-item="goods" wx:if="{{index < 2}}">
            {{goods.name}}
          </text>
          <text class="more-goods" wx:if="{{item.goods.length > 2}}">等{{item.goods.length}}种商品</text>
        </view>
      </view>
      
      <view class="dragon-info" bindtap="viewDragon" data-id="{{item._id}}">
        <view class="info-item">
          <text class="info-label">发起人:</text>
          <text class="info-value">{{item.creatorName}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">参与人数:</text>
          <text class="info-value">{{item.participantCount || 0}}人</text>
        </view>
      </view>
      
      <view class="dragon-time" bindtap="viewDragon" data-id="{{item._id}}">
        <text class="time-text">{{item.createTime}}</text>
      </view>
      
      <!-- 参与接龙按钮 -->
      <view class="dragon-actions">
        <button class="participate-btn" wx:if="{{item.status === 'active'}}" bindtap="participateDragon" data-id="{{item._id}}">
          参与接龙
        </button>
        <button class="participate-btn disabled" wx:else disabled>
          接龙已结束
        </button>
      </view>
    </view>
  </view>
</view>