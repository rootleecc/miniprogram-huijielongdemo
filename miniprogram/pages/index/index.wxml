<!--pages/index/index.wxml-->
<view class="container">
  <!-- 头部欢迎区域 -->
  <view class="header">
    <view class="welcome">
      <text class="title">接龙购物</text>
      <text class="subtitle">社群团购，优惠共享</text>
    </view>
    <view class="user-info" wx:if="{{hasUserInfo}}">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
    </view>
    <button class="login-btn" wx:else bindtap="getUserInfo">登录</button>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="createDragon">
      <image class="action-icon" src="../../images/icons/goods.png"></image>
      <text class="action-text">发起接龙</text>
    </view>
  </view>

  <!-- 接龙列表 -->
  <view class="dragon-list">
    <view class="list-header">
      <text class="list-title">最新接龙</text>
      <text class="list-count">{{dragonList.length}}个</text>
    </view>
    
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    
    <view class="empty" wx:elif="{{dragonList.length === 0}}">
      <image class="empty-icon" src="../../images/default-goods-image.png"></image>
      <text class="empty-text">暂无接龙活动</text>
      <button class="create-btn" bindtap="createDragon">发起第一个接龙</button>
    </view>
    
    <view class="dragon-item" wx:for="{{dragonList}}" wx:key="_id" bindtap="viewDragon" data-id="{{item._id}}">
      <view class="dragon-header">
        <view class="dragon-title">{{item.title}}</view>
        <view class="dragon-status {{item.status === 'active' ? 'active' : 'ended'}}">
          {{item.status === 'active' ? '进行中' : '已结束'}}
        </view>
      </view>
      
      <view class="dragon-desc">{{item.description}}</view>
      
      <view class="dragon-info">
        <view class="info-item">
          <text class="info-label">发起人:</text>
          <text class="info-value">{{item.creatorName}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">参与人数:</text>
          <text class="info-value">{{item.participantCount || 0}}人</text>
        </view>
      </view>
      
      <view class="dragon-time">
        <text class="time-text">{{item.createTime}}</text>
      </view>
    </view>
  </view>
</view>