/* pages/index/index.wxss */
page {
  background-color: #f5f7fa;
}

.container {
  padding: 0;
}

/* 头部区域 */
.header {
  background: linear-gradient(135deg, #0052D9 0%, #003ba3 100%);
  padding: 40rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
}

.welcome .title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.welcome .subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 快捷操作 */
.quick-actions {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 82, 217, 0.1);
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 20rpx;
}

.action-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 15rpx;
}

.action-text {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

/* 接龙列表 */
.dragon-list {
  margin: 20rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}

.list-count {
  font-size: 24rpx;
  color: #9ca3af;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #9ca3af;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  margin-bottom: 30rpx;
  font-size: 28rpx;
}

.create-btn {
  background: #0052D9;
  color: white;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

/* 接龙项目 */
.dragon-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 82, 217, 0.1);
  transition: transform 0.2s;
}

.dragon-item:active {
  transform: scale(0.98);
}

.dragon-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.dragon-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  flex: 1;
}

.dragon-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: white;
}

.dragon-status.active {
  background: #10b981;
}

.dragon-status.ended {
  background: #9ca3af;
}

.dragon-desc {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.dragon-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.info-item {
  font-size: 24rpx;
}

.info-label {
  color: #9ca3af;
}

.info-value {
  color: #1f2937;
  font-weight: 500;
}

.dragon-time {
  text-align: right;
}

.time-text {
  font-size: 22rpx;
  color: #d1d5db;
}