/* pages/create/create.wxss */
page {
  background-color: #f5f7fa;
}

.container {
  padding-bottom: 100rpx;
}

/* 头部 */
.header {
  position: relative;
  background: linear-gradient(135deg, #0052D9 0%, #1e40af 50%, #003ba3 100%);
  padding: 60rpx 30rpx 50rpx;
  color: white;
  overflow: hidden;
  min-height: 200rpx;
}

.header-background {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 20% 20%, rgba(255,255,255,0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 80%, rgba(255,255,255,0.08) 0%, transparent 50%),
    linear-gradient(135deg, rgba(255,255,255,0.05) 0%, transparent 100%);
}

.header-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
}

.header-icon {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  backdrop-filter: blur(10rpx);
  border: 3rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.icon-placeholder {
  font-size: 60rpx;
  line-height: 1;
}

.header-text {
  text-align: center;
}

.header .title {
  font-size: 52rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 15rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 2rpx;
}

.header .subtitle {
  font-size: 30rpx;
  opacity: 0.95;
  font-weight: 400;
  line-height: 1.4;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.15);
}

.header-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  pointer-events: none;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  animation: float 6s ease-in-out infinite;
}

.circle-1 {
  width: 100rpx;
  height: 100rpx;
  top: 20rpx;
  right: 50rpx;
  animation-delay: 0s;
}

.circle-2 {
  width: 60rpx;
  height: 60rpx;
  top: 120rpx;
  left: 40rpx;
  animation-delay: 2s;
}

.circle-3 {
  width: 80rpx;
  height: 80rpx;
  bottom: 30rpx;
  right: 30rpx;
  animation-delay: 4s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0px) scale(1);
    opacity: 0.6;
  }
  50% {
    transform: translateY(-20rpx) scale(1.1);
    opacity: 0.8;
  }
}

/* 表单 */
.form {
  padding: 0 30rpx;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 82, 217, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.add-btn {
  background: #0052D9;
  color: white;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 30rpx;
}

.form-item.half {
  width: 48%;
}

.form-row {
  display: flex;
  justify-content: space-between;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #1f2937;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.input, .textarea {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 10rpx;
  font-size: 28rpx;
  background: #f9fafb;
  box-sizing: border-box;
}

.input:focus, .textarea:focus {
  border-color: #0052D9;
  background: white;
}

.textarea {
  height: 150rpx;
  resize: none;
}

.textarea.small {
  height: 100rpx;
}

.picker {
  padding: 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 10rpx;
  background: #f9fafb;
  color: #1f2937;
}

/* 商品列表 */
.goods-item {
  border: 2rpx solid #e5e7eb;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 25rpx;
  background: #f9fafb;
}

.goods-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

.goods-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
}

.remove-btn {
  background: #ef4444;
  color: white;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}

/* 图片上传 */
.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.image-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  object-fit: cover;
}

.remove-image {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ef4444;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.upload-btn {
  width: 150rpx;
  height: 150rpx;
  border: 2rpx dashed #d1d5db;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9fafb;
}

.upload-text {
  font-size: 60rpx;
  color: #d1d5db;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #e5e7eb;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #0052D9 0%, #003ba3 100%);
  color: white;
  border-radius: 50rpx;
  padding: 25rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
}

.submit-btn.disabled {
  background: #d1d5db;
  opacity: 0.6;
}