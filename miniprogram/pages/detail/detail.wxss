/* pages/detail/detail.wxss */
page {
  background-color: #f5f7fa;
}

.container {
  padding-bottom: 120rpx;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #9ca3af;
  font-size: 28rpx;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #0052D9 0%, #003ba3 100%);
  padding: 40rpx 30rpx;
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  flex: 1;
}

.status {
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: white;
}

.status.active {
  background: rgba(16, 185, 129, 0.8);
}

.status.ended {
  background: rgba(156, 163, 175, 0.8);
}

/* 内容区域 */
.content {
  padding: 0 30rpx;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 82, 217, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 25rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #e5e7eb;
}

/* 信息项 */
.info-item {
  display: flex;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.info-label {
  color: #6b7280;
  font-size: 28rpx;
  min-width: 140rpx;
}

.info-value {
  color: #1f2937;
  font-size: 28rpx;
  flex: 1;
}

/* 商品列表 */
.goods-item {
  border: 2rpx solid #e5e7eb;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  background: #f9fafb;
}

.goods-info {
  margin-bottom: 20rpx;
}

.goods-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 10rpx;
}

.goods-price {
  font-size: 32rpx;
  color: #0052D9;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.goods-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

.goods-images {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.goods-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  object-fit: cover;
}

/* 参与列表 */
.participant-item {
  border-bottom: 1rpx solid #e5e7eb;
  padding: 20rpx 0;
}

.participant-item:last-child {
  border-bottom: none;
}

.participant-info {
  display: flex;
  align-items: flex-start;
}

.participant-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.participant-details {
  flex: 1;
}

.participant-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.participant-items {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.participant-items text {
  margin-right: 15rpx;
}

.participant-amount {
  font-size: 26rpx;
  color: #0052D9;
  font-weight: bold;
}

/* 我的参与信息 */
.my-participation {
  background: #eff6ff;
  border: 2rpx solid #0052D9;
  border-radius: 15rpx;
  padding: 25rpx;
  position: relative;
}

.my-items {
  font-size: 28rpx;
  color: #1f2937;
  margin-bottom: 10rpx;
}

.my-items text {
  margin-right: 15rpx;
}

.my-amount {
  font-size: 30rpx;
  color: #0052D9;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.view-detail {
  font-size: 24rpx;
  color: #0052D9;
}

/* 操作按钮 */
.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #e5e7eb;
  display: flex;
  gap: 15rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
}

.action-btn.primary {
  background: linear-gradient(135deg, #0052D9 0%, #003ba3 100%);
  color: white;
}

.action-btn.secondary {
  background: #e5e7eb;
  color: #1f2937;
}

.action-btn.success {
  background: #10b981;
  color: white;
}

.action-btn.disabled {
  background: #d1d5db;
  color: #9ca3af;
}

.action-btn.share {
  background: #f59e0b;
  color: white;
}