/* pages/detail/detail.wxss */
page {
  background-color: #f5f5f5;
}

.container {
  padding-bottom: 120rpx;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  flex: 1;
}

.status {
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: white;
}

.status.active {
  background: rgba(82, 196, 26, 0.8);
}

.status.ended {
  background: rgba(153, 153, 153, 0.8);
}

/* 内容区域 */
.content {
  padding: 0 30rpx;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* 信息项 */
.info-item {
  display: flex;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.info-label {
  color: #666;
  font-size: 28rpx;
  min-width: 140rpx;
}

.info-value {
  color: #333;
  font-size: 28rpx;
  flex: 1;
}

/* 商品列表 */
.goods-item {
  border: 2rpx solid #f0f0f0;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  background: #fafafa;
}

.goods-info {
  margin-bottom: 20rpx;
}

.goods-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.goods-price {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.goods-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.goods-images {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.goods-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  object-fit: cover;
}

/* 参与列表 */
.participant-item {
  border-bottom: 1rpx solid #f0f0f0;
  padding: 20rpx 0;
}

.participant-item:last-child {
  border-bottom: none;
}

.participant-info {
  display: flex;
  align-items: flex-start;
}

.participant-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.participant-details {
  flex: 1;
}

.participant-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.participant-items {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.participant-items text {
  margin-right: 15rpx;
}

.participant-amount {
  font-size: 26rpx;
  color: #ff6b35;
  font-weight: bold;
}

/* 我的参与信息 */
.my-participation {
  background: #f8f9ff;
  border: 2rpx solid #667eea;
  border-radius: 15rpx;
  padding: 25rpx;
  position: relative;
}

.my-items {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.my-items text {
  margin-right: 15rpx;
}

.my-amount {
  font-size: 30rpx;
  color: #ff6b35;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.view-detail {
  font-size: 24rpx;
  color: #667eea;
}

/* 操作按钮 */
.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #e8e8e8;
  display: flex;
  gap: 15rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.action-btn.secondary {
  background: #f0f0f0;
  color: #333;
}

.action-btn.success {
  background: #52c41a;
  color: white;
}

.action-btn.disabled {
  background: #ccc;
  color: #999;
}

.action-btn.share {
  background: #ff6b35;
  color: white;
}